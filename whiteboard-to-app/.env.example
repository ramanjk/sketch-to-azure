# Copy to .env and fill in your own values. .env is gitignored.

# Azure OpenAI vision (required for live mode)
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_API_KEY=              # optional; omit to use your `az login` token

# Optional real deploy of the demo-safe subset into a dedicated resource group
# DEPLOY_RG=rg-whiteboard-demo
# DEPLOY_MODE=real                   # 'real' | 'whatif'
