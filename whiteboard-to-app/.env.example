# Copy to .env and fill in your own values. .env is gitignored.

# Azure OpenAI vision (required for live mode)
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_API_KEY=              # optional; omit to use your `az login` token

# Optional real deploy of the demo-safe subset into a dedicated resource group
# DEPLOY_RG=rg-whiteboard-demo
# DEPLOY_MODE=real                   # 'real' | 'whatif'

# Microsoft 365 Copilot / Copilot Studio custom connector
# Generate unique values with: openssl rand -hex 32
# AGENT_API_KEY=
# AGENT_PLAN_SIGNING_KEY=            # optional; defaults to AGENT_API_KEY
# AGENT_PLAN_TTL_SECONDS=86400
# AGENT_IMAGE_MAX_BYTES=10485760
# GENERIC_IAC_MAX_ATTEMPTS=5

# Azure Container Apps deployment (used by deploy-container-app.sh)
# AZURE_OPENAI_RESOURCE_GROUP=rg-ai
# AZURE_OPENAI_RESOURCE_NAME=my-aoai
# APP_RESOURCE_GROUP=rg-whiteboard-agent
# LOCATION=eastus
